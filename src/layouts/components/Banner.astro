---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
const { banner } = Astro.props;
const { title, button, image, content } = banner;
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1 class="banner-title" set:html={markdownify(title)} />

        <p class="mt-6" set:html={markdownify(content)} />

        <div class="mt-5">
          <a href="../../../public/pdf/Proposal.pdf" download >
            <p class="btn btn-primary">Download Brosur</p>
          </a>
        </div>

        <div class="mt-5 flex flex-row space-x-4 items-center">
          <a
            href="https://play.google.com/store/apps/details?id=com.agara.hadir"
          >
            <Image
              alt="android"
              src="/images/android.png"
              width={200}
              height={100}
            />
          </a>
          <a href="https://apps.apple.com/us/app/hadir/id6566194497">
            <Image
              alt="android"
              src="/images/ios.png"
              width={180}
              height={80}
            />
          </a>
        </div>
      </div>
      <div class="lg:col-6">
        <Image
          class="w-full object-contain"
          alt="banner"
          src={image}
          width={603}
          height={396}
        />
      </div>
    </div>
  </div>

  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%]"
    alt="banner"
    src="/images/banner-shape.png"
    width={496}
    height={466}
  />
</section>
